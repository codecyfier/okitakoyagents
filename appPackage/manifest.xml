<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>8d9a8e1c-1d5c-4af5-8bb8-7df8c0d4f6ab</Id>
  <Version>1.0.0.1</Version>
  <ProviderName>Okitakoy</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="Okitakoy CoreAI" />
  <Description DefaultValue="Assistant IA Okitakoy CoreAI dans Microsoft Word." />
  <IconUrl DefaultValue="https://okitakoy-agents.onrender.com/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://okitakoy-agents.onrender.com/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://okitakoy-agents.onrender.com/" />
  <AppDomains>
    <AppDomain>https://okitakoy-agents.onrender.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="WordApi" MinVersion="1.3" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://okitakoy-agents.onrender.com/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Description resid="CoreAI.Description" />
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="WordApi" MinVersion="1.3" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CoreAI.GroupV2">
                <Label resid="CoreAI.GroupLabel" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16" />
                  <bt:Image size="32" resid="Icon.32" />
                  <bt:Image size="80" resid="Icon.80" />
                </Icon>
                <Control xsi:type="Button" id="CoreAI.ShowTaskpaneV2">
                  <Label resid="CoreAI.ButtonLabel" />
                  <Supertip>
                    <Title resid="CoreAI.ButtonLabel" />
                    <Description resid="CoreAI.ButtonDescription" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>CoreAITaskpaneV2</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://okitakoy-agents.onrender.com/assets/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://okitakoy-agents.onrender.com/assets/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://okitakoy-agents.onrender.com/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://okitakoy-agents.onrender.com/taskpane.html" />
        <bt:Url id="Commands.Url" DefaultValue="https://okitakoy-agents.onrender.com/commands.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="CoreAI.GroupLabel" DefaultValue="Okitakoy CoreAI" />
        <bt:String id="CoreAI.ButtonLabel" DefaultValue="Ouvrir CoreAI" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="CoreAI.Description" DefaultValue="Assistant IA Okitakoy CoreAI pour Word." />
        <bt:String id="CoreAI.ButtonDescription" DefaultValue="Ouvre le volet de l'assistant IA Okitakoy CoreAI." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
